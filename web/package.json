{
  "name": "scrawl-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:page && node icons.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:page": "vite build -c vite.page.config.ts && for entry in math site boot mermaid plantuml; do SCRAWL_PAGE_ENTRY=$entry vite build -c vite.page.config.ts || exit 1; done"
  },
  "dependencies": {
    "@codemirror/commands": "6.9.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@lezer/highlight": "1.2.3",
    "@mantine/core": "9.6.1",
    "@mantine/form": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@mantine/modals": "9.6.1",
    "@mantine/notifications": "9.6.1",
    "@phosphor-icons/react": "2.1.10",
    "@plantuml/core": "1.2026.9",
    "@uiw/react-codemirror": "4.25.11",
    "dompurify": "3.4.15",
    "katex": "0.16.47",
    "mermaid": "12.0.0",
    "prettier": "3.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "postcss": "8.5.28",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
